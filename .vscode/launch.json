    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Run HParam Opt",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/notebooks/02_three_stage_system/optimize_hparams.py",
            "console": "integratedTerminal",
            "args": [
                "--study-name",
                "ppo_hierarchical",
                "--n-processes",
                "1",
                "--reset-log-directories",
                "--drop-database"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "python": "${command:python.interpreterPath}",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}